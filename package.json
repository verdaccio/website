{
  "private": true,
  "name": "website-root",
  "author": {
    "name": "Verdaccio Maintainers",
    "email": "verdaccio.npm@gmail.com"
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/verdaccio/website"
  },
  "homepage": "https://verdaccio.org",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/verdaccio"
  },
  "devDependencies": {
    "@babel/cli": "8.0.6",
    "@babel/core": "8.0.6",
    "@babel/node": "8.0.6",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/plugin-proposal-function-sent": "8.0.1",
    "@babel/plugin-proposal-throw-expressions": "8.0.1",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-syntax-import-meta": "7.10.4",
    "@babel/plugin-transform-async-to-generator": "8.0.1",
    "@babel/plugin-transform-class-properties": "8.0.1",
    "@babel/plugin-transform-classes": "8.0.5",
    "@babel/plugin-transform-export-namespace-from": "8.0.1",
    "@babel/plugin-transform-json-strings": "8.0.1",
    "@babel/plugin-transform-nullish-coalescing-operator": "8.0.1",
    "@babel/plugin-transform-numeric-separator": "8.0.1",
    "@babel/plugin-transform-object-rest-spread": "8.0.1",
    "@babel/plugin-transform-optional-chaining": "8.0.5",
    "@babel/plugin-transform-runtime": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@babel/register": "8.0.6",
    "@babel/runtime": "8.0.5",
    "@types/debug": "4.1.13",
    "@types/lodash": "4.17.25",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router-dom": "5.3.3",
    "@types/sanitize-html": "2.16.1",
    "@verdaccio/local-scripts": "workspace:*",
    "babel-plugin-dynamic-import-node": "2.3.3",
    "cross-env": "10.1.0",
    "debug": "4.4.3",
    "fs-extra": "11.4.1",
    "got": "16.0.0",
    "kleur": "4.1.5",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "rimraf": "6.1.3",
    "sanitize-html": "2.17.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "scripts": {
    "clean": "pnpm --filter \"./packages/**\" clean",
    "build": "pnpm --filter \"./packages/**\" build && pnpm --filter @verdaccio/test-cli-commons build",
    "format": "oxfmt --ignore-path .oxfmtignore --write \"**/*.{js,jsx,ts,tsx,json,yml,yaml,md}\"",
    "format:check": "oxfmt --ignore-path .oxfmtignore --check \"**/*.{js,jsx,ts,tsx,json,yml,yaml,md}\"",
    "lint": "oxlint --deny-warnings --ignore-path .oxlintignore .",
    "test": "pnpm --filter \"./packages/**\" test",
    "ts:ref": "update-ts-references --discardComments --rootConfigName tsconfig.base.json",
    "website": "pnpm --filter ...@verdaccio/website build",
    "deploy:gh-pages": "pnpm --filter ...@verdaccio/website deploy-gh-pages",
    "script:addon": "tsx ./scripts/addon-update.ts"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.9.0"
}
